# Neon connection string (zorg dat hij eindigt op ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optioneel: poort waarop de server luistert (Render zet zelf PORT).
PORT=3000

# Publieke URL van de site (zonder trailing slash) — voor hreflang-tags.
CANONICAL_URL=https://jouw-site.onrender.com

# Beheerderslogin voor /admin (stel in via Render Environment Variables)
ADMIN_USER=admin
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Willekeurige string voor het tekenen van sessie-cookies (genereer zelf, bijv. openssl rand -hex 32)
SESSION_SECRET=verander-dit

# Zet op "disable" om SSL uit te zetten (alleen voor lokale Postgres).
# PGSSL=disable
