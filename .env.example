# Neon connection string (zorg dat hij eindigt op ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optioneel: poort waarop de server luistert (Render zet zelf PORT).
PORT=3000

# Zet op "disable" om SSL uit te zetten (alleen voor lokale Postgres).
# PGSSL=disable
